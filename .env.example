# ─── Server ───────────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────
# Path to the SQLite database file
DB_PATH=./service_requests.db

# ─── Authentication ───────────────────────────────────────
# CHANGE THIS to a long, random secret string in production!
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=ServiceDesk Pro
